<Window x:Class="IndustrialVisualAnomalyDetection.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analysisModels="clr-namespace:IndustrialVisualAnomalyDetection.Desktop.Models.Analysis"
        Title="Industrial Visual Anomaly Detection"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0"
                Padding="20"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="5"
                            Height="34"
                            Margin="0,1,12,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2" />

                    <TextBlock Style="{StaticResource ApplicationTitleTextStyle}"
                               Text="Industrial Visual Anomaly Detection" />
                </StackPanel>

                <TextBlock Margin="17,6,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Inspect industrial images through the verified backend inference workflow." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <Border Margin="0,0,8,0"
                            Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource StatusIndicatorStyle}"
                                 Tag="{Binding BackendAvailabilityStatus}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding BackendLivenessText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource StatusIndicatorStyle}"
                                 Tag="{Binding InferenceAvailabilityStatus}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding InferenceReadinessText}" />
                        </StackPanel>
                    </Border>

                <Button Margin="12,0,0,0"
                        Command="{Binding RefreshHealthCommand}"
                        Content="Refresh status" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Primary workflow -->
        <Grid Grid.Row="1" Margin="0,28,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Image selection and preview -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   Text="Image inspection" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Select one PNG or JPEG image before starting the analysis." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,12,0"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedImagePathText, Mode=OneWay}" />

                        <Button Grid.Column="1"
                                Command="{Binding SelectImageCommand}"
                                Content="Select image" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MetricLabelTextStyle}"
                                       Text="IMAGE OVERLAY" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding IsHeatmapVisible}">
                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                               Text="Show heatmap" />
                                </CheckBox>

                                <TextBlock Margin="18,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Opacity" />

                                <Slider Width="110"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsHeatmapVisible}"
                                        Maximum="1"
                                        Minimum="0"
                                        Value="{Binding HeatmapOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Width="42"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MonospaceTextStyle}"
                                           Text="{Binding HeatmapOpacity, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource ImageCanvasStyle}">
                            <Grid>
                                <Image Margin="12"
                                       Source="{Binding SelectedImagePreview}"
                                       Stretch="Uniform" />

                                <Image Margin="12"
                                       Opacity="{Binding HeatmapOpacity}"
                                       Source="{Binding HeatmapImageSource}"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeatmapVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="PNG or JPEG · maximum 10 MiB" />

                        <Button Grid.Column="1"
                                Margin="0,0,10,0"
                                Command="{Binding AnalyzeImageCancelCommand}"
                                Content="Cancel" />

                        <Button Grid.Column="2"
                                Command="{Binding AnalyzeImageCommand}"
                                Content="Analyze image"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Analysis result -->
            <Border Grid.Column="2" Style="{StaticResource RaisedPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   Text="Analysis result" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="The backend decision remains authoritative." />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,20,0,18"
                            Padding="16"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDecision}"
                                                 Value="{x:Static analysisModels:AnalysisDecision.Normal}">
                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding CurrentDecision}"
                                                 Value="{x:Static analysisModels:AnalysisDecision.Anomalous}">
                                        <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}"
                                       Text="DECISION" />

                            <TextBlock Margin="0,5,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="{Binding DecisionText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentDecision}"
                                                         Value="{x:Static analysisModels:AnalysisDecision.Normal}">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding CurrentDecision}"
                                                         Value="{x:Static analysisModels:AnalysisDecision.Anomalous}">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}"
                                           Text="ANOMALY SCORE" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource MetricValueTextStyle}"
                                           Text="{Binding ScoreText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}"
                                           Text="THRESHOLD" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource MetricValueTextStyle}"
                                           Text="{Binding ThresholdText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="3" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricLabelTextStyle}" Text="MODEL" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource BodyTextStyle}" Text="{Binding ModelIdText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource MetricLabelTextStyle}" Text="CATEGORY" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding CategoryText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource MetricLabelTextStyle}" Text="PROCESSING" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ProcessingTimeText}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource MetricLabelTextStyle}" Text="TRACE ID" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,12,0,0" Style="{StaticResource MonospaceTextStyle}" Text="{Binding TraceIdText}" />
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,20,0,0">
                        <ProgressBar IsIndeterminate="{Binding IsAnalysisRunning}" Value="0" />
                        <TextBlock Margin="0,9,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Environment footer -->
        <Border Grid.Row="2"
                Padding="14,9"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource MetricLabelTextStyle}"
                           Text="BACKEND" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Style="{StaticResource MonospaceTextStyle}"
                           Text="https://localhost:7056" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Analysis client" />
            </Grid>
        </Border>
    </Grid>
</Window>
