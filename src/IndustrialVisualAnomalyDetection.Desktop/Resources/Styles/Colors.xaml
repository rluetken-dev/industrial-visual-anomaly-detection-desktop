<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Industrial dark surfaces -->
    <Color x:Key="AppBackgroundColor">#0B1120</Color>
    <Color x:Key="SurfaceColor">#111827</Color>
    <Color x:Key="RaisedSurfaceColor">#172033</Color>
    <Color x:Key="MutedSurfaceColor">#1E293B</Color>
    <Color x:Key="ImageCanvasColor">#060B14</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="StrongBorderColor">#475569</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#F1F5F9</Color>
    <Color x:Key="SecondaryTextColor">#CBD5E1</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="DisabledTextColor">#64748B</Color>

    <!-- Primary analysis accent -->
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentHoverColor">#06B6D4</Color>
    <Color x:Key="AccentPressedColor">#0891B2</Color>
    <Color x:Key="AccentSurfaceColor">#123241</Color>

    <!-- Semantic states -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="SuccessSurfaceColor">#12351F</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSurfaceColor">#3A2810</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSurfaceColor">#3A171B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="{StaticResource RaisedSurfaceColor}" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="{StaticResource MutedSurfaceColor}" />
    <SolidColorBrush x:Key="ImageCanvasBrush" Color="{StaticResource ImageCanvasColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
</ResourceDictionary>
